# vhost change for browsable storage.oceanmetrics.io -- PREPARED, NOT DEPLOYED (2026-10-08)
#
# Applies to MarineSensitivity/server (git apply docs/vhost_gazetteer_browse.diff, from the repo root).
# The storage.* vhost lives in caddy/Caddyfile there and serves BOTH storage.marinesensitivity.org
# and storage.oceanmetrics.io, so this changes the bare root of both hosts.
#
# What is and is not needed:
#  * /gazetteer/**/ -- NO change. The deployed vhost (server 6d55227 and earlier) already matches
#    ^/(marine-atlas|gazetteer)(/|$), rewrites any "*/" path to {path}index.html and proxies
#    */index.html and */README.md; everything else is a 302 to S3. Verified live: GET /gazetteer/
#    returns the S3 403 (the proxied index.html object does not exist yet), not Caddy's 404/302.
#    Browsing starts working at every depth the moment build_browse_pages.py's output is uploaded.
#  * the bare root (/) -- this change. Today `redir / /marine-atlas/ 302` means a root listing can
#    never be seen. The diff proxies /index.html from the bucket instead (the object already exists;
#    it currently lists only marine-atlas/ and is written by msens publish_storage_index.qmd).
#    storage_host_local.sh: the two "/ -> /marine-atlas/" assertions become "/ is a 200 text/html page".
#
# Checked locally (homebrew caddy): caddy/test/caddyfile_adapt_local.sh -> ADAPT_OK (adapts, validates,
# caddy fmt clean) with the patched Caddyfile; the patched storage vhost serves / as 200 text/html.
#
# How it deploys (from MarineSensitivity/workflows release_marine-atlas.qmd, chunk deploy-caddy):
# merge to server main, then DEPLOY_CADDY=1 on that notebook: ssh msens, `git merge --ff-only`,
# `docker compose build caddy`, `caddy validate`, `docker compose restart caddy` (a restart, not
# `caddy reload` -- the Caddyfile is a bind-mounted single file), then caddy/test/run.sh.
#
# Order: upload the root index.html (see below) BEFORE deploying, or the root serves the old
# marine-atlas-only page. Who writes the root index.html must be decided once: the msens notebook
# rewrites it on every run from its marine-atlas-only listing, so either it adds the gazetteer
# prefix (and stops overwriting root) or this repo's `build_browse_pages.py --root` owns it.
diff --git a/caddy/Caddyfile b/caddy/Caddyfile
index be6da4e..272378e 100644
--- a/caddy/Caddyfile
+++ b/caddy/Caddyfile
@@ -265,8 +265,18 @@ Disallow: /*.zip$
 		}
 	}
 
-	# the bare host lands on the atlas index
-	redir / /marine-atlas/ 302
+	# the bare host: the root index.html (lists marine-atlas/ and gazetteer/ only -- never
+	# backups/ or the other top-level prefixes). Generated by
+	# oceanmetrics/places scripts/build_browse_pages.py --root, or by the msens
+	# publish_storage_index notebook once it lists both prefixes.
+	@root path /
+	handle @root {
+		rewrite * /index.html
+		reverse_proxy https://s3.us-east-1.amazonaws.com {
+			header_up Host s3.us-east-1.amazonaws.com
+			rewrite /oceanmetrics.io-public{uri}
+		}
+	}
 
 	# anything else: refuse, and say where to go
 	handle {
diff --git a/caddy/test/storage_host_local.sh b/caddy/test/storage_host_local.sh
index ae24673..2f59a5f 100755
--- a/caddy/test/storage_host_local.sh
+++ b/caddy/test/storage_host_local.sh
@@ -65,8 +65,9 @@ is "redirect carries no body bytes"         0   "$(curl -s -H 'Range: bytes=0-4'
 is "query string survives the redirect"     "$S3/marine-atlas/latest.txt?a=1&b=two" "$(loc "$base/marine-atlas/latest.txt?a=1&b=two")"
 is "gazetteer data object -> 302"           "$S3/gazetteer/x/y.parquet" "$(loc "$base/gazetteer/x/y.parquet")"
 is "deep parquet object -> 302 (not proxied)" 302 "$(code "$base/marine-atlas/v8/tables/zone.parquet")"
-is "/ -> /marine-atlas/"                    "$base/marine-atlas/" "$(loc "$base/")"
-is "/ is a 302"                             302 "$(code "$base/")"
+is "/ is proxied (root index page)"         200 "$(code "$base/")"
+is "/ is not redirected"                    "" "$(loc "$base/")"
+is "/ is text/html"                         "text/html" "$(curl -s -o /dev/null -w '%{content_type}' "$base/" | cut -d';' -f1)"
 is "robots.txt"                             200 "$(code "$base/robots.txt")"
 is "robots.txt keeps crawlers off objects"  1   "$(curl -s "$base/robots.txt" | grep -c '^Disallow: /\*\.parquet\$')"
 is "/backups/anything is 404"               404 "$(code "$base/backups/anything")"
