{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "moduleDetection": "force",
    "paths": {
      "@oceanmetrics/places": ["../../platform/packages/places/src/index.ts"],
      "@oceanmetrics/status": ["../../platform/packages/status/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
